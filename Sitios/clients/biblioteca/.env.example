# GA4 — prueba en local (no se commitea: usá .env o .env.local)
# 1. En analytics.google.com creá una propiedad GA4 y copiá el Measurement ID (G-...).
# 2. Copiá este archivo a .env y completá el ID.
# 3. npm run dev -w biblioteca → en GA: Informes → Tiempo real.
# 4. Cuando termines la prueba, borrá PUBLIC_GA_ENABLE_IN_DEV o ponelo en false.

# Measurement ID del flujo Web (Admin → Flujos de datos → Web). Formato G-ABC12XYZ34.
# No uses el Property ID numérico ni le antepongas G-.
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
PUBLIC_GA_ENABLE_IN_DEV=true
